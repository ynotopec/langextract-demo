# API access token, distinct from the model provider key.
# Minimum 8 characters: uppercase, lowercase, digit and special character; no whitespace.
# Generate a token using the README instructions, or configure your own.
# Quote values containing special characters with single quotes.
API_TOKEN=

OPENAI_API_MODEL=mistral-small-vllm
OPENAI_API_BASE=http://127.0.0.1:8000/v1
OPENAI_API_KEY=replace-me

# JSON by default; use 0 for endpoints that require YAML output.
# USE_OPENAI_JSON_MODE=1
# MAX_UPLOAD_BYTES=20971520
# MAX_TEXT_CHARS=500000
