{
  "openapi": "3.1.0",
  "info": {
    "title": "LangExtract PDF",
    "version": "0.2.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health",
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/config": {
      "get": {
        "summary": "Config",
        "operationId": "config_api_v1_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/extractions": {
      "post": {
        "summary": "Extract",
        "operationId": "extract_api_v1_extractions_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "options": {
                    "type": "string",
                    "description": "Objet JSON : prompt, extraction_passes, max_workers, max_char_buffer, include_text"
                  }
                },
                "type": "object",
                "required": [
                  "file"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ExtractionResponse": {
        "properties": {
          "document": {
            "additionalProperties": true,
            "type": "object",
            "title": "Document"
          },
          "jsonl": {
            "type": "string",
            "title": "Jsonl"
          },
          "html": {
            "type": "string",
            "title": "Html"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "skipped_pages": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Skipped Pages"
          },
          "omitted_entities": {
            "type": "integer",
            "title": "Omitted Entities"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "document",
          "jsonl",
          "html",
          "warnings",
          "skipped_pages",
          "omitted_entities",
          "text"
        ],
        "title": "ExtractionResponse"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
